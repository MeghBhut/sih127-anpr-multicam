# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/

# Model weights — download, don't commit
*.pt
*.onnx
*.pth
*.safetensors
anpr/en_dict.txt

# PaddleOCR clones itself here on first OCR call (plate_reader._ensure_paddleocr)
anpr/PaddleOCR/
PaddleOCR/

# Scratch output from the linker tools
demo.db
threshold_report.json

# Test footage — too big for git, share over Drive
anpr/data/videos/*
!anpr/data/videos/.gitkeep

# Run output - regenerate with one command
anpr/out/**
!anpr/out/
!anpr/out/frames/
!anpr/out/crops/
!anpr/out/crops/fail/
!anpr/out/journeys/
!anpr/out/montage/
!anpr/out/**/.gitkeep

# rollback copy main.py keeps while a run replaces the database
*.prev.db

# Cached OpenStreetMap tiles for the map, and the tracker yaml the detector
# generates on first run
anpr/data/map_cache/
anpr/botsort_fixed_cam.yaml

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
